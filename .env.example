# Copy this file to .env and replace the placeholders with your environment.
# Never add access tokens, client secrets, connection strings, or SAS tokens.

# EventhouseKustoIngest configuration
KUSTO_QUERY_URI=https://<eventhouse-host>.kusto.fabric.microsoft.com
KUSTO_INGEST_URI=https://ingest-<eventhouse-host>.kusto.fabric.microsoft.com
KUSTO_DATABASE=<database-name>
KUSTO_TABLE=<table-name>
KUSTO_MAPPING=<avro-mapping-name>

# EventHubTickerProducer and eventhubAvro configuration (no secrets)
EVENTHUBS_HOST=<namespace>.servicebus.windows.net
EVENTHUB_NAME=stock-ticks

# Azure CLI authentication and resource selection
AZURE_TENANT_ID=<tenant-id>
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=<resource-group>

# Fabric deployment metadata; do not paste deployment IDs into documentation.
FABRIC_WORKSPACE_ID=<workspace-id>
FABRIC_WORKSPACE_NAME=<workspace-name>
FABRIC_KQL_DATABASE=<kql-database-name>
FABRIC_CLOUD_CONNECTION_NAME=<cloud-connection-name>
FABRIC_CLOUD_CONNECTION_ID=<cloud-connection-id>
FABRIC_DATA_CONNECTION_ID=<data-connection-id>
FABRIC_CONSUMER_GROUP=<consumer-group-name>
FABRIC_EVENTHUB_AUTH_RULE=<listen-only-rule-name>

# Rayfin config interpolation. Import this file into the shell before rayfin up.
# Use each app's own ignored rayfin/.env for generated runtime properties.
FINANCE_APP_ORIGIN=https://<finance-app>.webapp.<region>.fabricapps.net
FINANCE_APP_ITEM_ID=<finance-app-item-id>
HELSINKI_APP_ORIGIN=https://<helsinki-app>.webapp.<region>.fabricapps.net
HELSINKI_APP_ITEM_ID=<helsinki-app-item-id>
HELSINKI_SEMANTIC_MODEL_ID=<semantic-model-id>

# NYC Taxi helper configuration
FABRIC_TARGET_ACCOUNT=<account-upn>
# Optional; defaults to the encrypted Azure cache under the current user profile.
# FABRIC_TOKEN_CACHE_PATH=<absolute-cache-path>
# Optional; defaults to python on PATH.
# FABRIC_PYTHON_EXE=<python-executable>
